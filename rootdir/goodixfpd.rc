# Goodix fingerprint daemon. Installed to /system/etc/init.
# Matches the stock service definition (class main, user/group system).
service goodixfpd /system/bin/goodixfingerprintd
    class main
    user system
    group system
    seclabel u:r:fingerprintd:s0

# The fingerprint HAL (class hal) opens the device only once at start. Restart
# it once goodixfpd is running so it connects to the daemon; this also covers
# a daemon restart.
on property:init.svc.goodixfpd=running
    restart vendor.fps_hal
