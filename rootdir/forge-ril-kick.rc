# One-shot RIL watchdog; see /system/bin/forge-ril-kick.sh. Limits itself to
# 10 minutes after boot.
service forge-ril-kick /system/bin/sh /system/bin/forge-ril-kick.sh
    class late_start
    user root
    group root radio
    oneshot
    disabled

on property:sys.boot_completed=1
    start forge-ril-kick
