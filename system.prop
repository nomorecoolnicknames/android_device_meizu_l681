# System properties for Meizu M3 Note (l681).

ro.forge.meizu.expect_codename=l681

# Display
ro.sf.lcd_density=480

# RIL
# The argument contains a space, so it must be set in system.prop.
rild.libargs=-d /dev/ttyC0

# The panel scanout is physically upside down. Matches
# CONFIG_MTK_LCM_PHYSICAL_ROTATION="180" (not the _HW variant).
ro.sf.hwrotation=180

# No hardware navigation keys; show the on-screen navigation bar.
qemu.hw.mainkeys=0

# ro.treble.enabled is set by the build from PRODUCT_FULL_TREBLE.
